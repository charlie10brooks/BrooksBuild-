# Copy to .env. Used by docker-compose.yml (and read by the app with the TERRASCOPE_ prefix).

# ABSOLUTE path on the Docker host. It is mounted at the SAME path inside the containers because the worker starts
# OpenDroneMap with `docker run -v <this path>/...:/datasets/code`, and the Docker daemon resolves that path on the host.
TERRASCOPE_DATA_DIR=/srv/terrascope

# Safeguards (bytes; 0 = unlimited). There is deliberately no limit on the NUMBER of images.
TERRASCOPE_MIN_FREE_BYTES=2147483648
TERRASCOPE_PROJECT_QUOTA_BYTES=0
TERRASCOPE_MAX_FILE_BYTES=8589934592

# Job system
TERRASCOPE_WORKER_CONCURRENCY=2
TERRASCOPE_HEAVY_CONCURRENCY=1

# External tools
TERRASCOPE_ODM_IMAGE=opendronemap/odm:latest
TERRASCOPE_ODM_ARGS=
TERRASCOPE_PDAL_BIN=pdal
# TERRASCOPE_SEGMENTATION_MODEL=/models/landcover.onnx

# Never enable on a shared server: exposes the synthetic-sample endpoint.
TERRASCOPE_DEV_MODE=0
